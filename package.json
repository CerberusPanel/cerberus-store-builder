{
	"name": "cerberus-store-builder",
	"productName": "Cerberus Store Builder",
	"description": "Build, validate, version and export self-contained Cerberus app store release files.",
	"homepage": "https://github.com/CerberusPanel/cerberus-store-builder",
	"license": "PolyForm-Noncommercial-1.0.0",
	"author": {
		"name": "Ryvor",
		"email": "rsmith_20@outlook.com"
	},
	"private": true,
	"version": "1.0.0-beta2",
	"type": "module",
	"main": "electron/main.js",
	"scripts": {
		"dev": "vite",
		"dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
		"build": "vite build",
		"build:desktop": "vite build && electron-builder",
		"build:win": "vite build && electron-builder --win",
		"build:mac": "vite build && electron-builder --mac",
		"build:linux": "vite build && electron-builder --linux",
		"preview": "vite preview"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@vitejs/plugin-vue": "latest",
		"vite": "latest",
		"vue": "latest"
	},
	"devDependencies": {
		"concurrently": "latest",
		"cross-env": "latest",
		"electron": "latest",
		"electron-builder": "latest",
		"wait-on": "latest"
	},
	"build": {
		"appId": "com.ryvor.cerberus.storebuilder",
		"productName": "Cerberus Store Builder",
		"artifactName": "Cerberus-Store-Builder-${version}-${os}-${arch}.${ext}",
		"directories": {
			"output": "dist-electron"
		},
		"files": [
			"dist/**/*",
			"electron/**/*",
			"package.json",
			"build/logo-transparent.png"
		],
		"extraResources": [
			{
				"from": "build/com.ryvor.CerberusStoreBuilder.metainfo.xml",
				"to": "com.ryvor.CerberusStoreBuilder.metainfo.xml"
			}
		],
		"asar": true,
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": [
				"dmg",
				"zip"
			]
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"linux": {
			"category": "Development",
			"synopsis": "Create and publish Cerberus app-store release files.",
			"description": "Create, validate, version, and export self-contained Cerberus app-store release files with version-specific deployment configuration.",
			"maintainer": "Ryvor <rsmith_20@outlook.com>",
			"vendor": "Cerberus",
			"desktop": {
				"entry": {
					"Name": "Cerberus Store Builder",
					"Comment": "Create and publish Cerberus app-store release files",
					"Categories": "Development;",
					"Keywords": "cerberus;app store;deployment;docker;"
				}
			},
			"target": [
				"AppImage",
				"deb"
			]
		},
		"deb": {
			"packageCategory": "devel",
			"priority": "optional",
			"afterInstall": "build/deb-postinstall.sh",
			"afterRemove": "build/deb-postremove.sh"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		},
		"icon": "build/logo-transparent.png"
	}
}
