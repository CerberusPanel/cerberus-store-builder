{
	"name": "cerberus-store-builder",
	"productName": "Cerberus Store Builder",
	"desktopName": "com.cerberus.storebuilder",
	"version": "1.0.0-beta3",
	"homepage": "https://github.com/CerberusPanel/cerberus-store-builder",
	"description": "Build, validate, version and export self-contained Cerberus app store release files.",
	"author": {
		"name": "Ryvor",
		"email": "rsmith_20@outlook.com"
	},
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"main": "electron/main.js",
	"scripts": {
		"dev": "vite",
		"dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
		"build": "vite build",
		"build:desktop": "vite build && electron-builder",
		"build:win": "vite build && electron-builder --win",
		"build:mac": "vite build && electron-builder --mac",
		"build:linux": "vite build && electron-builder --linux && ./scripts/patch-deb.sh",
		"preview": "vite preview"
	},
	"dependencies": {
		"@mdi/js": "^7.4.47",
		"@vitejs/plugin-vue": "latest",
		"vite": "latest",
		"vue": "latest"
	},
	"devDependencies": {
		"concurrently": "latest",
		"cross-env": "latest",
		"electron": "latest",
		"electron-builder": "latest",
		"wait-on": "latest"
	},
	"build": {
		"appId": "com.cerberus.storebuilder",
		"productName": "Cerberus Store Builder",
		"directories": {
			"output": "dist-electron"
		},
		"files": [
			"dist/**/*",
			"electron/**/*",
			"package.json"
		],
		"asar": true,
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": [
				"dmg",
				"zip"
			]
		},
		"linux": {
			"target": [
				"AppImage",
				"deb",
				"snap"
			],

			"icon": "build/icons",

			"category": "Development",
			"synopsis": "Store manifest editor for Cerberus",
			"description": "A desktop application for creating, editing, validating and exporting Cerberus application store manifests.",

			"maintainer": "Robert Smith",
			"vendor": "Cerberus",

			"syncDesktopName": true,

			"desktop": {
				"entry": {
					"Name": "Cerberus Store Builder",
					"Comment": "Create and edit Cerberus app store manifests",
					"Categories": "Development;Utility;",
					"Keywords": "cerberus;store;docker;server;apps;",
					"Terminal": false,
					"Type": "Application",
					"StartupWMClass": "com.cerberus.storebuilder"
				}
			}
		},
		"deb": {
			"packageCategory": "devel",
			"priority": "optional"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		},
		"icon": "build/icons/512x512.png"
	}
}
