#!/usr/bin/make -f

# Build only with dependencies supplied by Build-Depends.  npm must not fetch
# packages or run dependency lifecycle scripts during a Debian package build.
export npm_config_audit = false
export npm_config_fund = false
export npm_config_update_notifier = false

%:
	dh $@

override_dh_auto_build:
	npm --offline --ignore-scripts run build

override_dh_auto_test:
	# No automated test suite is currently provided upstream.

override_dh_auto_install:
	install -d debian/cerberus-store-builder/usr/lib/cerberus-store-builder
	cp -a dist electron debian/cerberus-store-builder/usr/lib/cerberus-store-builder/
	install -m 0644 package.json debian/cerberus-store-builder/usr/lib/cerberus-store-builder/
	install -d debian/cerberus-store-builder/usr/bin
	printf '%s\\n' '#!/bin/sh' \
		'exec /usr/bin/electron /usr/lib/cerberus-store-builder/electron/main.js "$$@"' \
		> debian/cerberus-store-builder/usr/bin/cerberus-store-builder
	chmod 0755 debian/cerberus-store-builder/usr/bin/cerberus-store-builder

override_dh_auto_clean:
	dh_auto_clean
	rm -rf dist
